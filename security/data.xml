<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!--
        Un grupo de permisos por módulo nativo.

        Cada grupo herea del grupo "User" del módulo (`implied_ids`), no del
        "Administrator". Asi el usuario del grupo ve el modulo, y los submenus
        que Odoo restringe al Administrator (p.ej. POS > Configuration) le
        quedan ocultos solos, sin tocar los menus nativos.

        No se tocan los menus: el sidebar ya filtra por permisos con
        `menuService.getAll()` (ver static/src/sidebar/nav_entries.js).
    -->

    <record id="group_crm_erpico" model="res.groups">
        <field name="name">CRM ERPICO</field>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_ventas_erpico" model="res.groups">
        <field name="name">Ventas ERPICO</field>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_pos_erpico" model="res.groups">
        <field name="name">POS ERPICO</field>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>

    <record id="group_compras_erpico" model="res.groups">
        <field name="name">Compras ERPICO</field>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>

    <record id="group_inventario_erpico" model="res.groups">
        <field name="name">Inventario ERPICO</field>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_website_erpico" model="res.groups">
        <field name="name">Website ERPICO</field>
        <field name="implied_ids" eval="[(4, ref('website.group_website_designer'))]"/>
    </record>
</odoo>
