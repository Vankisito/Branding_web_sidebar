<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="erpico_web_sidebar.Home">
        <div class="o_erpico_home">
            <header class="o_erpico_home_header">
                <h1 class="o_erpico_home_title">Inicio</h1>
                <p class="o_erpico_home_subtitle">
                    Elegí un módulo para empezar a trabajar.
                </p>
            </header>

            <div class="o_erpico_home_grid">
                <t t-foreach="state.cards" t-as="card" t-key="card.id">
                    <button
                        type="button"
                        class="o_erpico_home_card"
                        t-on-click="() => this.openCard(card)"
                    >
                        <span class="o_erpico_home_card_icon">
                            <t t-if="card.icon.kind === 'img'">
                                <img t-att-src="card.icon.src" alt=""/>
                            </t>
                            <t t-else="">
                                <svg aria-hidden="true">
                                    <use t-att-href="card.icon.src"/>
                                </svg>
                            </t>
                        </span>
                        <span class="o_erpico_home_card_body">
                            <span class="o_erpico_home_card_title" t-esc="card.title"/>
                            <span class="o_erpico_home_card_text" t-esc="card.subtitle"/>
                        </span>
                        <svg class="o_erpico_home_card_arrow" aria-hidden="true">
                            <use href="/erpico_web_sidebar/static/src/icons/ui-sprite.svg#i-arrow"/>
                        </svg>
                    </button>
                </t>
            </div>

            <p t-if="!state.cards.length" class="o_erpico_home_empty">
                No tenés módulos disponibles con tu perfil.
            </p>
        </div>
    </t>

</templates>
