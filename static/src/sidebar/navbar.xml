<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="erpico_web_sidebar.NavBar">
        <header class="o_navbar" t-ref="root">
            <nav
                class="o_main_navbar d-print-none"
                data-command-category="disabled"
            >
                <button
                    class="o_erpico_mobile_toggle"
                    aria-label="Abrir menú"
                    title="Abrir menú"
                    t-on-click="() => this.env.bus.trigger('erpico:open-drawer')"
                >
                    <i class="fa fa-bars" aria-hidden="true"/>
                </button>

                <!-- Brand del módulo actual (D-28) -->
                <t t-if="currentApp">
                    <button
                        class="o_erpico_module_brand"
                        t-att-class="{ 'o_active': currentApp }"
                        t-att-title="currentApp.name"
                        t-on-click="() => this.onNavBarDropdownItemSelection(currentApp)"
                    >
                        <span t-esc="currentApp.name"/>
                    </button>
                </t>

                <!-- Breadcrumbs del módulo (D-28) -->
                <div class="o_navbar_breadcrumbs d-contents"/>

                <!-- Secciones del módulo (D-28) -->
                <t t-if="!this.ui.isSmall and currentAppSections.length">
                    <t t-call="web.NavBar.SectionsMenu">
                        <t t-set="sections" t-value="currentAppSections" />
                    </t>
                </t>

                <!-- Systray de Odoo intacto (buscador, notificaciones, usuario...) -->
                <div class="o_menu_systray d-flex flex-shrink-0 ms-auto bg-inherit" role="menu">
                    <t t-foreach="systrayItems" t-as="item" t-key="item.key">
                        <div t-att-data-index="item.index"/>
                        <ErrorHandler onError="error => this.handleItemError(error, item)">
                            <t t-component="item.Component" t-props="item.props"/>
                        </ErrorHandler>
                    </t>
                </div>
            </nav>
        </header>
    </t>

</templates>
