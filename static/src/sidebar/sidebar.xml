<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="erpico_web_sidebar.Sidebar">
        <nav
            t-if="state.ready"
            t-att-class="'o_erpico_sidebar ' + (state.fullscreenHidden ? 'o_erpico_sidebar-fullscreen-hidden' : 'd-none d-lg-flex')"
            aria-label="Aplicaciones ERPICO"
        >
            <!-- Rail -->
            <div class="o_erpico_rail">
                <a
                    href="/odoo"
                    class="o_erpico_rail_logo"
                    aria-label="ERPICO, inicio"
                    t-on-click="() => { this.state.allAppsOpen = false; }"
                >
                    <img
                        src="/erpico_web_sidebar/static/src/images/erpico-favicon.png"
                        alt="ERPICO"
                    />
                </a>

                <div class="o_erpico_rail_apps">
                    <t t-foreach="state.entries" t-as="entry" t-key="entry.id">
                        <button
                            type="button"
                            class="o_erpico_rail_btn"
                            t-att-class="{ 'o_active': this.isEntryActive(entry) }"
                            t-att-title="entry.label"
                            t-att-aria-label="entry.label"
                            t-on-mouseenter="() => this.hoverEntry(entry)"
                            t-on-mouseleave="() => this.clearHover()"
                            t-on-click.stop="() => this.selectEntry(entry)"
                            t-on-keydown="(ev) => this._onRailKeydown(entry, ev)"
                        >
                            <t t-if="entry.icon.kind === 'img'">
                                <img class="o_erpico_rail_icon" t-att-src="entry.icon.src" alt="" />
                            </t>
                            <t t-else="">
                                <svg class="o_erpico_rail_icon o_erpico_rail_svg" aria-hidden="true">
                                    <use t-att-href="entry.icon.src" />
                                </svg>
                            </t>
                        </button>
                    </t>
                </div>

                <div class="o_erpico_rail_footer">
                    <button
                        type="button"
                        class="o_erpico_rail_btn"
                        t-att-class="{ 'o_active': state.allAppsOpen }"
                        title="Todas las aplicaciones"
                        aria-label="Todas las aplicaciones"
                        t-on-click="() => this.toggleAllApps()"
                    >
                        <svg class="o_erpico_rail_icon o_erpico_rail_svg" aria-hidden="true">
                            <use href="/erpico_web_sidebar/static/src/icons/ui-sprite.svg#i-grid" />
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Flyout de la entrada en hover -->
            <div
                t-if="state.flyoutEntry and !state.allAppsOpen"
                class="o_erpico_flyout"
                t-on-mouseenter="() => this._onFlyoutEnter()"
                t-on-mouseleave="() => this._onFlyoutLeave()"
            >
                <div class="o_erpico_flyout_header">
                    <strong t-esc="state.flyoutEntry.label"/>
                    <button
                        type="button"
                        class="o_erpico_flyout_link"
                        t-on-click.stop="() => this.selectEntry(state.flyoutEntry)"
                    >
                        <span>Ir a la app</span>
                        <svg class="o_erpico_flyout_arrow" aria-hidden="true">
                            <use href="/erpico_web_sidebar/static/src/icons/ui-sprite.svg#i-arrow" />
                        </svg>
                    </button>
                </div>
                <t t-foreach="state.flyoutEntry.sections" t-as="section" t-key="section.label">
                    <span
                        t-if="state.flyoutEntry.sections.length > 1"
                        class="o_erpico_flyout_group"
                        t-esc="section.label"
                    />
                    <ul class="o_erpico_flyout_menu">
                        <t t-call="erpico_web_sidebar.FlyoutMenu">
                            <t t-set="items" t-value="section.childrenTree"/>
                        </t>
                    </ul>
                </t>
            </div>

            <!-- Panel "Todas las aplicaciones" -->
            <div t-if="state.allAppsOpen" class="o_erpico_allapps">
                <div class="o_erpico_flyout_header">
                    <strong>Todas las aplicaciones</strong>
                </div>
                <ul class="o_erpico_allapps_grid">
                    <t t-foreach="allAppsList" t-as="app" t-key="app.id">
                        <li>
                            <t t-set="icon" t-value="this.iconFor(app)"/>
                            <t t-if="icon.kind === 'img'">
                                <img class="o_erpico_allapps_icon" t-att-src="icon.src" alt="" />
                            </t>
                            <t t-else="">
                                <svg class="o_erpico_allapps_icon" aria-hidden="true">
                                    <use t-att-href="icon.src" />
                                </svg>
                            </t>
                            <span t-esc="app.name"/>
                            <button
                                type="button"
                                class="o_erpico_allapps_open"
                                aria-label="Abrir"
                                t-on-click.stop="() => this.openApp(app)"
                            />
                        </li>
                    </t>
                </ul>
            </div>
        </nav>

        <!-- Drawer móvil -->
        <t t-if="state.drawerOpen">
            <div class="o_erpico_backdrop" t-on-click="() => { this.state.drawerOpen = false; }" />
            <nav class="o_erpico_drawer">
                <div class="o_erpico_drawer_header">
                    <img
                        src="/erpico_web_sidebar/static/src/images/erpico-logo-horizontal.png"
                        alt="ERPICO"
                        class="o_erpico_drawer_logo"
                    />
                    <button
                        type="button"
                        class="o_erpico_drawer_close"
                        t-on-click="() => { this.state.drawerOpen = false; }"
                        aria-label="Cerrar menú"
                    >
                        <i class="fa fa-times" aria-hidden="true"/>
                    </button>
                </div>

                <div class="o_erpico_drawer_apps">
                    <t t-foreach="state.entries" t-as="entry" t-key="entry.id">
                        <div class="o_erpico_drawer_app">
                            <button
                                type="button"
                                class="o_erpico_drawer_app_btn"
                                t-att-class="{ 'o_active': this.isEntryActive(entry) }"
                                t-on-click="() => this.selectEntry(entry)"
                            >
                                <t t-if="entry.icon.kind === 'img'">
                                    <img class="o_erpico_drawer_icon" t-att-src="entry.icon.src" alt="" />
                                </t>
                                <t t-else="">
                                    <svg class="o_erpico_drawer_icon" aria-hidden="true">
                                        <use t-att-href="entry.icon.src" />
                                    </svg>
                                </t>
                                <span t-esc="entry.label"/>
                            </button>
                            <t t-foreach="entry.sections" t-as="section" t-key="section.label">
                                <span
                                    t-if="entry.sections.length > 1"
                                    class="o_erpico_drawer_group"
                                    t-esc="section.label"
                                />
                                <ul t-if="section.childrenTree.length" class="o_erpico_drawer_sub">
                                    <t t-foreach="section.childrenTree" t-as="child" t-key="child.id">
                                        <li
                                            t-att-class="{ 'o_active': section.leaf and section.leaf.id === child.id }"
                                            t-on-click="() => this.openItem(child)"
                                        >
                                            <span t-esc="child.name"/>
                                        </li>
                                    </t>
                                </ul>
                            </t>
                        </div>
                    </t>
                </div>

                <div class="o_erpico_drawer_footer">
                    <SwitchCompanyMenu />
                    <button
                        type="button"
                        class="o_erpico_drawer_settings"
                        t-on-click="() => this.goToSettings()"
                    >
                        <i class="fa fa-cog" aria-hidden="true"/>
                        <span>Ajustes</span>
                    </button>
                </div>
            </nav>
        </t>
    </t>

    <t t-name="erpico_web_sidebar.FlyoutMenu">
        <t t-foreach="items" t-as="item" t-key="item.id">
            <li t-if="!item.childrenTree.length">
                <button
                    type="button"
                    class="o_erpico_flyout_item"
                    t-on-click.stop="() => this.openItem(item)"
                    t-esc="item.name"
                />
            </li>
            <li t-else="">
                <span class="o_erpico_flyout_group" t-esc="item.name"/>
                <ul class="o_erpico_flyout_sub">
                    <t t-call="erpico_web_sidebar.FlyoutMenu">
                        <t t-set="items" t-value="item.childrenTree"/>
                    </t>
                </ul>
            </li>
        </t>
    </t>

</templates>
